/bin/
/dist/

# A stray binary from `go build ./cmd/tfdesktop` with no -o: it lands in the
# repo root as ./tfdesktop.
/tfdesktop
node_modules/
.DS_Store

# `mygo dev` / `mygo build` artifacts: the dev bundle and the Windows resource
# file mygo compiles into the app's main package.
/.mygo/
mygo_windows_*.syso

# Built frontend, embedded by internal/web. The marker is committed so a clean
# checkout can still build the daemon before the web step has ever run.
/internal/web/dist/*
!/internal/web/dist/.gitkeep

# Python bytecode, from helper scripts that have any.
__pycache__/

# `go tool mygo generate` writes a TypeScript client here for apps that bind
# services; Beacon's web client keeps its own copy of the strings.
/src/
